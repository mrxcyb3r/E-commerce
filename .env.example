# Supabase environment variables for local development.
#
# Copy this file to `.env` and fill in your project values.
# NEVER commit `.env` — it is gitignored. Replace real values with
# placeholders in any committed example.
#
# ── Client-facing (safe to expose in the browser bundle) ─────────────────────
# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Publishable key (sb_publishable_...) from Supabase Dashboard → Settings → API
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# ── Server-only (NEVER prefix with VITE_, must not reach the browser bundle) ──
# Used ONLY by server-side scripts (DB migrations, seeders, edge functions).
# Do not add these to Netlify site env as VITE_* variables.
# SUPABASE_SECRET_KEY="sb_secret_YOUR_SERVER_KEY"
# SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# ── Netlify deployment ────────────────────────────────────────────────────────
# Set these in the Netlify site dashboard (Site settings → Environment variables):
#   VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
#   VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
# Do NOT set any non-VITE_ secret as a VITE_* variable; Vite inlines every
# VITE_* var into the client bundle at build time.